# RuneSpace environment configuration (copy to .env and fill in).
# Validated at startup by server/env.ts (Zod).

# Deployment environment: development | test | production
NODE_ENV=development

# PostgreSQL connection string used by Drizzle / pg Pool.
# Local default matches docker-compose.yml below.
DATABASE_URL=postgres://runespace:runespace@localhost:5432/runespace

# Admin/operator console (issue #113). Comma-separated list of stable Better
# Auth user IDs allowed to use operator commands. Absent or empty => NO admins
# (the console fails closed). Never put real production IDs here.
# RUNESPACE_ADMIN_USER_IDS=

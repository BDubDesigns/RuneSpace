# RuneSpace environment configuration (copy to .env and fill in).
# Validated at startup by server/env.ts (Zod).

# Deployment environment: development | test | production
NODE_ENV=development

# PostgreSQL connection string used by Drizzle / pg Pool.
# Local default matches docker-compose.yml below.
DATABASE_URL=postgres://runespace:runespace@localhost:5432/runespace

# Admin/operator console (issue #113). Comma-separated list of stable Better
# Auth user IDs allowed to use operator commands. Absent or empty => NO admins
# (the console fails closed). Never put real production IDs here.
# RUNESPACE_ADMIN_USER_IDS=

# Account registration (issue #221; see docs/authentication.md).
# Development falls back to Cloudflare's always-pass Turnstile test keys and
# logs verification links to the server console when ZeptoMail is not set.
# Production registration stays closed until all four are configured — leave
# them unset in production until the issue #223 closed gameplay gate has been
# verified in production (see docs/gameplay-access.md).
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# ZEPTOMAIL_SEND_MAIL_TOKEN=
# RUNESPACE_MAIL_FROM_ADDRESS=accounts@runespace.qcfailed.com
# RUNESPACE_MAIL_FROM_NAME=RuneSpace
# ZEPTOMAIL_API_URL=https://api.zeptomail.com/v1.1/email

# Product analytics (issue #413; see docs/analytics.md). PostHog's PUBLIC,
# write-only project token and ingestion host. All three are inlined into the
# bundles by `next build`, so they must be available at BUILD time. Leave them
# unset locally and in CI: analytics only ever runs on the production host
# runespace.qcfailed.com, and unset means a safe no-op.
# NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Preview analytics is OFF unless a preview build lists its PR number here (set
# it only in Coolify's PREVIEW variables, for example 414; never for production,
# local runs or CI). Only the exact host pr-<number>.runespace.qcfailed.com of a
# listed PR then sends events, labeled environment=preview.
# NEXT_PUBLIC_ANALYTICS_PREVIEW_PRS=

# Scapelikes aggregate presence (production runtime only; see docs/deployment-database.md).
# SCAPELIKES_SITE_ID=
# SCAPELIKES_PRESENCE_CRON_SECRET=

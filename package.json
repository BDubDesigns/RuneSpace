{
  "name": "runespace",
  "version": "0.1.0",
  "private": true,
  "description": "RuneSpace — browser-first, mobile-friendly, low-fi sci-fi RPG (playable pre-alpha).",
  "engines": {
    "node": ">=22.0.0 <23.0.0",
    "pnpm": ">=9.0.0 <10.0.0"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "next dev",
    "studio": "node scripts/run-studio.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:studio": "vitest run tests/unit/qc-studio.test.ts tests/unit/qc-studio-adapter.test.ts",
    "test:watch": "vitest",
    "test:integration": "node scripts/disposable-test-db.mjs -- pnpm run test:integration:raw",
    "test:integration:raw": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "node scripts/disposable-test-db.mjs -- pnpm run test:e2e:raw",
    "test:e2e:raw": "playwright test",
    "test:e2e:studio": "node scripts/disposable-test-db.mjs -- pnpm run test:e2e:studio:raw",
    "test:e2e:studio:raw": "playwright test --config=playwright.qc-studio.config.ts",
    "maintenance:issue-126": "node --experimental-strip-types scripts/prealpha-mission-reset.mjs",
    "test:integration:issue-126": "RUNESPACE_ISSUE_126_INTEGRATION=true node scripts/disposable-test-db.mjs -- pnpm run test:integration:raw tests/integration/prealpha-mission-reset.test.ts",
    "test:e2e:canonical": "node scripts/run-canonical-e2e.mjs",
    "test:e2e:focused": "node scripts/run-focused-e2e.mjs"
  },
  "dependencies": {
    "next": "15.5.20",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "drizzle-orm": "0.45.2",
    "better-auth": "1.6.23",
    "@better-auth/drizzle-adapter": "1.6.23",
    "pg": "8.13.1",
    "lucide-react": "^1.40.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.2.0",
    "@playwright/test": "1.51.1",
    "autoprefixer": "10.4.20",
    "@types/node": "22.10.7",
    "@types/pg": "8.11.10",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "drizzle-kit": "0.31.10",
    "@better-auth/cli": "1.4.21",
    "eslint": "9.18.0",
    "eslint-config-next": "15.5.20",
    "prettier": "3.4.2",
    "prettier-plugin-tailwindcss": "0.6.9",
    "tailwindcss": "3.4.17",
    "postcss": "8.5.1",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  }
}
